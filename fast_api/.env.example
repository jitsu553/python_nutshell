# Local development defaults. Copy to .env and adjust as needed.

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/fastapi_db

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Use a long random value in real environments
SECRET_KEY=change-me-in-production-use-a-long-random-string

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=mistral:latest
